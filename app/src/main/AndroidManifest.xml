<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <uses-permission android:name="android.permission.VIBRATE"/>
    <uses-permission android:name="android.permission.SCHEDULE_EXACT_ALARM"/>
    <!-- Re-programme les alarmes notif après reboot du device — sans ça
         les rappels disparaissent jusqu'à la prochaine ouverture de l'app. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED"/>
    <!-- Foreground Service pour le coach vocal en background pendant les
         séances. mediaPlayback = on joue de l'audio TTS. Permission API 34+
         requise pour le foregroundServiceType="mediaPlayback". -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"/>
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>

    <application
        android:name=".ShredCoachApplication"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:enableOnBackInvokedCallback="true"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:localeConfig="@xml/locales_config"
        android:networkSecurityConfig="@xml/network_security_config"
        android:roundIcon="@mipmap/ic_launcher"
        android:supportsRtl="true"
        android:theme="@style/Theme.ShredCoach"
        android:usesCleartextTraffic="false"
        tools:targetApi="34">

        <activity
            android:name=".presentation.MainActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:configChanges="orientation|screenSize|screenLayout|keyboardHidden|smallestScreenSize|uiMode|density|fontScale|navigation"
            android:theme="@style/Theme.ShredCoach">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Désactiver l'init automatique de WorkManager (on utilise Configuration.Provider) -->
        <provider
            android:name="androidx.startup.InitializationProvider"
            android:authorities="${applicationId}.androidx-startup"
            android:exported="false"
            tools:node="merge">
            <meta-data
                android:name="androidx.work.WorkManagerInitializer"
                android:value="androidx.startup"
                tools:node="remove" />
        </provider>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.provider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>

        <!-- Reçoit les broadcasts d'alarmes programmées par
             NotificationAlarmScheduler. Action custom + exported=false :
             interne à l'app, pas accessible depuis l'extérieur. -->
        <receiver
            android:name=".notification.NotificationAlarmReceiver"
            android:enabled="true"
            android:exported="false">
            <intent-filter>
                <action android:name="com.shredcoach.app.notification.ALARM_FIRE" />
            </intent-filter>
        </receiver>

        <!-- Re-programme toutes les alarmes notif au reboot du device et
             après update Play Store. exported=true requis car les broadcasts
             système (BOOT_COMPLETED) viennent de l'OS. -->
        <receiver
            android:name=".notification.BootReceiver"
            android:enabled="true"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.BOOT_COMPLETED" />
                <action android:name="android.intent.action.MY_PACKAGE_REPLACED" />
            </intent-filter>
        </receiver>

        <!-- Foreground Service pour le coach vocal pendant les séances en
             background. foregroundServiceType="mediaPlayback" car on émet du
             TTS audio (countdown vocal, fin de repos). exported=false : pas
             d'API publique, démarré seulement par ActiveSessionManager. -->
        <service
            android:name=".domain.session.WorkoutSessionService"
            android:enabled="true"
            android:exported="false"
            android:foregroundServiceType="mediaPlayback" />

        <!-- AppCompat per-app locales : auto-stocke et restore le locale entre
             les cold-starts (API 33+ utilise le storage système, API <33 un
             SharedPreferences interne géré par AppCompat). On garde notre
             UserProfileEntity.languageTag comme source de vérité métier
             (visible dans les backups, modifiable via Settings de l'app), et
             AppCompat fait le caching local pour appliquer le locale AVANT
             que toute Activity ne se construise (zéro flicker FR→EN). -->
        <service
            android:name="androidx.appcompat.app.AppLocalesMetadataHolderService"
            android:enabled="false"
            android:exported="false">
            <meta-data
                android:name="autoStoreLocales"
                android:value="true" />
        </service>

    </application>

</manifest>
